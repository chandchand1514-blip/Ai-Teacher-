# REQUIRED: Google Gemini API key (used by server.ts for Gemini Live voice & vision)
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Server port (defaults to 3000)
PORT=3000

# Public URL where the app is hosted (used for links & deployment reference)
APP_URL=http://localhost:3000

# Admin Chand security passcode (6 digits recommended; leave empty to use persisted store)
ADMIN_PASSCODE=

# OPTIONAL: Only needed if you ask ChatGPT to port /live voice from Gemini to OpenAI Realtime API
OPENAI_API_KEY=
